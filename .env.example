# Postgres connection string. Matches docker-compose.yml defaults.
DATABASE_URL="postgresql://saas:saas@localhost:5432/saas"

# Generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=""

# Optional: Google OAuth sign-in. Leave unset to disable the Google button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: used to build absolute links (invite emails, Stripe redirect URLs).
# Falls back to the request's own host/origin when unset.
NEXT_PUBLIC_APP_URL=""

# Optional: transactional email via Resend (https://resend.com/api-keys).
# Without RESEND_API_KEY, invite emails are just logged to the console.
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# Optional: Stripe billing. Without STRIPE_SECRET_KEY and at least one price
# below, the billing page shows as unconfigured and the checkout/portal APIs
# return 501. Set STRIPE_PRICE_STARTER and/or STRIPE_PRICE_PRO to offer
# multiple plans, or just STRIPE_PRICE_ID for a single one.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# Optional: requests per minute allowed per API key. API_KEY_RATE_LIMIT_PER_MINUTE
# is the default (60) for any scope without its own override; set the
# READ/WRITE variants to give those scopes their own limit.
API_KEY_RATE_LIMIT_PER_MINUTE=""
API_KEY_RATE_LIMIT_READ_PER_MINUTE=""
API_KEY_RATE_LIMIT_WRITE_PER_MINUTE=""

# Optional: comma-separated emails granted access to the read-only /admin
# panel. Unset by default, so nobody has access until you set this.
SUPER_ADMIN_EMAILS=""
